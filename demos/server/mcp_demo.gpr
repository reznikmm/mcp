with "config/mcp_demo_config.gpr";

project MCP_Demo is

   for Source_Dirs use ("source", "../common", "config");
   for Object_Dir use ".obj/" & MCP_Demo_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("mcp_demo.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use MCP_Demo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end MCP_Demo;
